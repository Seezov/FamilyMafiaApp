---
import Base from '../../layouts/Base.astro';
import AwardCards from '../../components/AwardCards.astro';
import Bars from '../../components/Bars.astro';
import GamesBySeasonChart from '../../components/GamesBySeasonChart.astro';
import Kpi from '../../components/Kpi.astro';
import Panel from '../../components/Panel.astro';
import { loadPlayer, loadPlayers } from '../../lib/data';
import { GAMES, pct, ukCount } from '../../lib/format';
import { href } from '../../lib/url';
import { profileFor } from '../../lib/profiles/site';

export function getStaticPaths() {
  return loadPlayers().players.map((p) => ({ params: { slug: p.slug } }));
}
const p = loadPlayer(Astro.params.slug!);
const prof = profileFor(p.slug);
const shown = prof?.nick ?? p.name;
// Tournament prizes are hidden for now (tournament data is not ready); the total counts what is shown.
const HIDDEN_GROUPS = new Set(['Призові місця на турнірах']);
const groups = p.accomplishments.groups.filter((g) => !HIDDEN_GROUPS.has(g.title));
const a = { groups, total: groups.reduce((n, g) => n + g.cards.reduce((m, c) => m + c.count, 0), 0) };
const roleColor = { civilian: 'var(--civilian)', sheriff: 'var(--sheriff)', mafia: 'var(--mafia)', don: 'var(--don)' } as const;
const bm = p.bestMoves;
const fk = p.firstKill;
const chase = p.timeline.find((t) => t.needed);
---
<Base title={shown} description={`${shown}: ${pct(p.winRate)} WR · ${ukCount(p.games, GAMES)} · сезонів: ${p.seasons}`} active="players">
  <div class="pagehead hero">
    {prof?.avatar ? <img class="avatar" src={href(prof.avatar)} alt="" width="80" height="80" /> : <div class="avatar display">{p.initials}</div>}
    <div class="who">
      <div class="eyebrow">Гравець клубу</div>
      <h1 class="display">{shown}</h1>
      <div class="sub">{prof?.nick && <>у таблицях: {p.name} · </>}зіграно {ukCount(p.games, GAMES)}</div>
    </div>
  </div>

  <div class="kpis">
    <Kpi label="Відсоток перемог" value={pct(p.winRate, 1)} />
    <Kpi label="Сезони" value={String(p.seasons)} />
    <Kpi label="Досягнення" value={String(a.total)} />
  </div>

  {a.groups.length > 0 && (
    <Panel title="Досягнення" note={`усього ${a.total}`} class="awards">
      <AwardCards groups={a.groups} />
    </Panel>
  )}

  <div class="grid">
    <Panel title="Ігри по сезонах" note={chase ? `S${chase.seasonId}: до вищої ліги ще ${ukCount(chase.needed!, GAMES)}` : undefined} class="span-8"><GamesBySeasonChart timeline={p.timeline} slug={p.slug} /></Panel>
    <Panel title="Ролі" class="span-4">
      <Bars items={p.roles.map((r) => ({
        label: r.label, value: r.share, color: roleColor[r.role], badge: r.top,
        text: `${r.games} · ${pct(r.share)} · ${r.wins}/${r.games} перемог`,
      }))} />
    </Panel>
    <Panel title="Вбитий першим" note="Ігри за мирного й шерифа" class="span-6">
      <div class="duo">
        <Kpi label="Перший убитий" value={String(fk.total)} />
        <Kpi label="Місто програло після" value={String(fk.cityLost)} />
      </div>
      <p class="label">{fk.civSherGames > 0 ? `${pct(fk.total / fk.civSherGames, 1)} з ${fk.civSherGames} ігор за червоних` : 'Ще немає ігор за червоних'}</p>
    </Panel>
    <Panel title="Кращий хід" note="Знайдено чорних, коли вбитий першим" class="span-6">
      {bm.firstKilled === 0 ? <p class="label">Кращих ходів немає.</p> : (
        <Bars items={[
          { label: '3 чорних', value: bm.three / bm.firstKilled, text: `${bm.three}`, color: 'var(--good)' },
          { label: '2 чорних', value: bm.two / bm.firstKilled, text: `${bm.two}` },
          { label: '1 чорний', value: bm.one / bm.firstKilled, text: `${bm.one}` },
          { label: '0 чорних', value: bm.zero / bm.firstKilled, text: `${bm.zero}`, color: 'var(--muted)' },
        ]} />
      )}
    </Panel>
  </div>
</Base>

<style>
  .hero { flex-wrap: nowrap; gap: 20px; }
  .avatar { width: 80px; height: 80px; border-radius: 50%; display: grid; place-items: center;
    background: var(--bg); color: var(--city); font-size: 30px; flex: none; }
  .sub { color: var(--muted); margin-top: 2px; }
  img.avatar { object-fit: cover; padding: 0; }
  .who { min-width: 0; }
  .who h1 { overflow-wrap: anywhere; }
  .kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 14px; }
  @media (max-width: 599px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .kpis > :last-child { grid-column: span 2; } }
  .awards { margin-bottom: 16px; }
  .duo :global(.kpi) { background: var(--panel-2); }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 8px; }
</style>
