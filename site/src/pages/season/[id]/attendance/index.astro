---
import Base from '../../../../layouts/Base.astro';
import PlayerName from '../../../../components/PlayerName.astro';
import SeasonHead from '../../../../components/SeasonHead.astro';
import { attendance, attendanceText } from '../../../../lib/attendance';
import { loadGames, loadIndex, loadSeason } from '../../../../lib/data';
import { dayLabel } from '../../../../lib/games';
import { gamesHref } from '../../../../lib/url';
import { GAMES, PLAYERS, ukCount } from '../../../../lib/format';

export function getStaticPaths() {
  return loadIndex().seasons.map((s) => ({ params: { id: String(s.id) } }));
}
const id = Number(Astro.params.id);
const season = loadSeason(id);
const { days, totals } = attendance(loadGames(id));

---
<Base title={`${season.title} · Відвідуваність`} description={`${season.title}: хто грав у кожен ігровий день`} active="season">
  <SeasonHead id={id} tab="attendance" />
  <p class="intro">Хто грав у кожен ігровий день і скільки ігор, нові згори — рахуються всі ігри, рейтингові й ні.
    «Копіювати» кладе список дня в буфер обміну для чату.</p>
  <div class="days">
    {days.map((d) => (
      <section class="day">
        <header>
          <h2>{dayLabel(d.date)}</h2>
          <button type="button" class="copy" data-text={attendanceText(`${dayLabel(d.date)} · ${ukCount(d.games, GAMES)}`, d.players)}>Копіювати</button>
        </header>
        <p class="meta">
          <a href={gamesHref(id)}>{ukCount(d.games, GAMES)}</a> · {ukCount(d.players.length, PLAYERS)}
          {d.hosts.length > 0 && <> · ведучий {d.hosts.join(', ')}</>}
          {d.labels.map((l) => <span class="tag">{l}</span>)}
        </p>
        <ol>
          {d.players.map((p) => (
            <li><span>{p.slug ? <PlayerName slug={p.slug} name={p.name} /> : p.name}</span><span class="num">{p.games}</span></li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <section class="totals">
    <h2>Підсумок сезону</h2>
    <table>
      <thead><tr><th>Гравець</th><th class="num">Дні</th><th class="num">Ігри</th></tr></thead>
      <tbody>
        {totals.map((t) => (
          <tr><td>{t.slug ? <PlayerName slug={t.slug} name={t.name} /> : t.name}</td><td class="num">{t.days}</td><td class="num">{t.games}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>

<script>
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button.copy');
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.text!); b.textContent = 'Скопійовано'; } catch { b.textContent = 'Не вдалося'; }
    setTimeout(() => (b.textContent = 'Копіювати'), 1500);
  });
</script>

<style>
  .intro { color: var(--muted); margin: 0 0 16px; max-width: 70ch; }
  .days { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .day, .totals { background: var(--panel); min-width: 0; }
  .day header, .totals h2 { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .day h2, .totals h2 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 18px; text-transform: uppercase; }
  .copy { margin-left: auto; font-size: 12px; min-height: 28px; padding: 2px 10px; }
  .meta { color: var(--muted); font-size: 12px; margin: 0; padding: 10px 16px 6px; }
  .meta a { color: var(--city); font-weight: 700; }
  .tag { display: inline-block; margin-left: 6px; padding: 0 8px; background: var(--bg); font-weight: 600; }
  ol { list-style: none; margin: 0; padding: 0 16px 10px; }
  li { display: flex; justify-content: space-between; gap: 8px; padding: 6px 0; border-top: 1px solid var(--line); }
  li:first-child { border-top: 0; }
  li .num { font-weight: 700; }
  .totals { margin-top: 24px; max-width: 520px; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-weight: 700; color: var(--muted); font-size: 11px; text-transform: uppercase; padding: 8px 16px; background: var(--panel-2); }
  td { padding: 8px 16px; border-top: 1px solid var(--line); }
  .num { text-align: center; }
</style>
