---
import PlayerName from './PlayerName.astro';
import type { GameEntry, ColorGuess } from '../lib/types';
import { fmtPts } from '../lib/games';

interface Props { game: GameEntry; autoLabel: string; seasonId: number }
const { game: g, autoLabel } = Astro.props;
const roleLabel: Record<string, string> = { civilian: 'Мирний', sheriff: 'Шериф', mafia: 'Мафія', don: 'Дон' };
const result = { city: 'Місто', mafia: 'Мафія', unrated: 'Не рейтинг' }[g.result];
const cols = [
  { k: 'fouls', label: 'Фоли', tip: 'Фоли' },
  { k: 'won', label: 'Бал', tip: '1 за перемогу' },
  { k: 'add', label: 'Доп', tip: 'Додаткові бали від ведучого' },
  { k: 'ad', label: 'АД', tip: 'Автоматичні додаткові бали' },
  { k: 'bm', label: autoLabel, tip: `${autoLabel} — бали першого вбитого` },
  { k: 'pen', label: 'Штраф', tip: 'Штраф' },
  { k: 'prAdd', label: 'ПрДод', tip: 'Додаткові бали за протокол' },
  { k: 'prPen', label: 'ПрШтраф', tip: 'Штраф за протокол' },
] as const;
const shown = cols.filter((c) => g.seats.some((s) => s[c.k] !== undefined));
const cell = (s: GameEntry['seats'][number], k: (typeof cols)[number]['k']) =>
  k === 'won' ? (s.won ? '1' : '') : k === 'fouls' ? (s.fouls ? String(s.fouls) : '') : fmtPts(s[k]);
const tone = (s: GameEntry['seats'][number], k: (typeof cols)[number]['k']) => {
  const v = k === 'won' || k === 'fouls' ? undefined : s[k];
  return v === undefined || v === 0 ? undefined : v > 0 ? 'pos' : 'neg';
};
const seatName = (n: number) => g.seats[n - 1]?.player ?? '—';
const keys = g.seats.map((s) => s.key).filter(Boolean).join('|');
const best = g.result === 'unrated' ? undefined
  : g.seats.filter((s) => s.player && s.total !== undefined).sort((a, b) => (b.total ?? 0) - (a.total ?? 0))[0];
---
<details class="game" id={g.id} data-keys={keys} data-host={g.host ?? ''} data-result={g.result}>
  <summary>
    <span class="n display">#{g.n}</span>
    <span class={`res r-${g.result}`}>{result}</span>
    <span class="col host"><span class="cap">Ведучий</span><span class="strong">{g.host ?? '—'}</span></span>
    {g.label && <span class="tag">{g.label}</span>}
    {g.seats.filter((s) => s.key).map((s) => (
      <span class="pick" data-k={s.key} hidden><span class={`dot d-${s.role}`} />{roleLabel[s.role] ?? s.role} · {fmtPts(s.total) || '0'}</span>
    ))}
    {best && <span class="col best"><span class="cap">Кращий гравець</span><span><span class="strong">{best.player}</span> <span class="tone-pos strong">{fmtPts(best.total)}</span></span></span>}
    <span class="chev" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg></span>
  </summary>
  <div class="body">
    <div class="scroll">
      <table>
        <thead><tr>
          <th class="num">#</th><th>Гравець</th><th>Роль</th>
          {shown.map((c) => <th class="num" title={c.tip}>{c.label}</th>)}
          <th class="num" title="Сума колонок (без доповнення СІ)">Разом</th>
        </tr></thead>
        <tbody>
          {g.seats.map((s) => (
            <tr class:list={{ won: s.won }}>
              <td class="num seat">{s.n}</td>
              <td class="player">{s.player ? (s.slug ? <PlayerName slug={s.slug} name={s.player} /> : s.player) : '—'}</td>
              <td><span class={`role r-${s.role}`}>{roleLabel[s.role] ?? s.role}</span></td>
              {shown.map((c) => <td class:list={['num', tone(s, c.k) && `tone-${tone(s, c.k)}`]}>{cell(s, c.k)}</td>)}
              <td class="num total">{fmtPts(s.total)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {(g.firstKilled || g.bestMove || g.supportFive || g.protocol) && (
      <div class="facts">
        {g.firstKilled && (
          <div class="fact"><div class="cap" title="Перший убитий">Перший убитий</div><div><span class="seatno">{g.firstKilled}</span> {seatName(g.firstKilled)}</div></div>
        )}
        {g.bestMove && (
          <div class="fact"><div class="cap" title="Кращий хід">{autoLabel}</div><div class="chips">{g.bestMove.map((n) => <span class="seatno">{n}</span>)}{g.bestMovePoints !== undefined && <span class="strong">{fmtPts(g.bestMovePoints)}</span>}</div></div>
        )}
        {g.supportFive && (
          <div class="fact"><div class="cap">Опорна 5</div><div class="chips">{g.supportFive.map((c: ColorGuess) => <span class:list={['seatno', c.black ? 'black' : 'red']} title={c.black ? 'чорний' : 'червоний'}>{c.seat}</span>)}</div></div>
        )}
        {g.protocol && (
          <div class="fact wide"><div class="cap">Протокол</div>
            <ol class="proto">{g.protocol.map((p) => (
              <li><span class="seatno">{p.killed}</span> {seatName(p.killed)}{p.version && <span class="muted"> · шериф {p.version}</span>}
                {p.colors.length > 0 && <span class="chips inline">{p.colors.map((c) => <span class:list={['seatno', c.black ? 'black' : 'red']} title={c.black ? 'чорний' : 'червоний'}>{c.seat}</span>)}</span>}
              </li>
            ))}</ol>
          </div>
        )}
      </div>
    )}
    {g.comments && (
      <ul class="comments">{g.comments.map((c) => (
        <li>{c.seats.length > 0 && <b>{c.seats.join(', ')} — </b>}<span>{c.text}</span></li>
      ))}</ul>
    )}
    <button type="button" class="copy" data-id={g.id}>Скопіювати посилання</button>
  </div>
</details>

<style>
  .game + .game { border-top: 1px solid var(--line); }
  summary { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; padding: 12px 20px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--panel-2); }
  .n { width: 44px; font-size: 22px; color: var(--muted); }
  .res { width: 100px; padding: 5px 0; text-align: center; font-weight: 700; font-size: 12px; text-transform: uppercase; color: #fff; }
  .r-city { background: var(--role-civilian-bg); } .r-mafia { background: var(--role-mafia-bg); } .r-unrated { background: var(--muted); }
  .col { display: flex; flex-direction: column; line-height: 1.35; }
  .host { flex: 1; min-width: 120px; }
  .best { text-align: right; }
  .cap { font-size: 12px; color: var(--muted); }
  .strong { font-weight: 700; }
  .muted { color: var(--muted); }
  .tag { font-size: 12px; font-weight: 600; padding: 3px 8px; background: var(--bg); color: var(--muted); }
  .pick[hidden] { display: none; }
  .pick { font-weight: 700; display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; background: var(--bg); }
  .dot { width: 8px; height: 8px; display: inline-block; }
  .d-civilian { background: var(--role-civilian-bg); } .d-sheriff { background: var(--role-sheriff-bg); }
  .d-mafia { background: var(--role-mafia-bg); } .d-don { background: var(--role-don-bg); }
  .chev svg { width: 18px; height: 18px; fill: none; stroke: var(--muted); stroke-width: 2; transition: transform .15s; display: block; }
  details[open] .chev svg { transform: rotate(180deg); }
  details[open] summary { background: var(--panel-2); }
  .body { padding: 16px 20px 18px; border-top: 1px solid var(--line); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; min-width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: 0 10px; height: 36px; text-align: left; white-space: nowrap; border-bottom: 1px solid var(--line); }
  th { background: var(--panel-2); color: var(--muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; height: 32px; }
  th.num, td.num { text-align: center; }
  td.seat { color: var(--muted); font-family: var(--font-display); font-weight: 700; width: 40px; }
  td.player { font-weight: 600; }
  tr.won td.player { font-weight: 800; }
  td.total { font-weight: 800; background: var(--panel-2); }
  .role { display: inline-block; min-width: 72px; padding: 2px 8px; font-size: 12px; font-weight: 700; color: #fff; text-align: center; }
  .role.r-civilian { background: var(--role-civilian-bg); } .role.r-sheriff { background: var(--role-sheriff-bg); }
  .role.r-mafia { background: var(--role-mafia-bg); } .role.r-don { background: var(--role-don-bg); }
  .facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr)); gap: 12px; margin-top: 14px; }
  .fact { background: var(--panel-2); padding: 10px 12px; display: grid; gap: 6px; align-content: start; }
  .fact.wide { grid-column: 1 / -1; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
  .chips.inline { display: inline-flex; margin-left: 8px; vertical-align: middle; }
  .seatno { display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 4px; font-weight: 700; font-size: 12px;
    background: var(--bg); color: var(--text); box-shadow: inset 0 0 0 1px var(--border); }
  .seatno.red { background: var(--role-civilian-bg); color: #fff; }
  .seatno.black { background: var(--role-mafia-bg); color: #fff; box-shadow: inset 0 0 0 1px var(--border); }
  .proto { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .comments { margin: 14px 0 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .comments li { padding: 8px 12px; background: var(--panel-2); }
  .comments span { white-space: pre-line; }
  .copy { margin-top: 14px; font: inherit; font-size: 13px; font-weight: 600; padding: 7px 14px; cursor: pointer;
    background: none; color: var(--text); border: 1px solid var(--border); }
  .copy:hover { border-color: var(--text); }
  @media (max-width: 639px) {
    summary { padding: 12px 16px; gap: 8px 12px; }
    .n { width: auto; font-size: 18px; }
    .res { width: 82px; }
    .best { flex-basis: 100%; text-align: left; flex-direction: row; gap: 6px; }
    .chev { margin-left: auto; }
    .body { padding: 14px 16px; }
  }
</style>
