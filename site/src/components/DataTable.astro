---
import type { SiteCell, SiteTable } from '../lib/types';
import { sortedIndices } from '../lib/sort';
import { wrTone } from '../lib/format';
import { profileFor } from '../lib/profiles/site';
import PlayerName from './PlayerName.astro';

interface Props { table: SiteTable; compact?: boolean }
const { table, compact = false } = Astro.props;
const { columns, showRank } = table;
const order = table.sortColumn === undefined
  ? table.rows.map((_, i) => i)
  : sortedIndices(table.rows, table.sortColumn, table.desc ? 'desc' : 'asc');
const hasHidden = columns.some((c) => c.phone === false);
const hasGroups = columns.some((c) => c.group);
const groups: { label: string; key: string; span: number }[] = [];
for (const c of columns) {
  const last = groups.at(-1);
  if (last && last.label === (c.group ?? '') && c.group) last.span++;
  else groups.push({ label: c.group ?? '', key: c.groupKey ?? (c.group ?? '').toLowerCase(), span: 1 });
}
const toneClass = (c: SiteCell) =>
  c.tone === 'wr' ? `tone-${wrTone(c.s) ?? 'low'}` : c.tone ? `tone-${c.tone}` : undefined;
const collapsed = table.collapsed && table.rows.length > table.collapsed ? table.collapsed : undefined;
const colCount = columns.length + (showRank ? 1 : 0);
---
{table.rows.length === 0 ? (
  <p class="empty">{table.empty ?? 'Немає даних.'}</p>
) : (
  <div class:list={['dt', { compact }]} data-table data-collapsed={collapsed}>
    <div class="scroll">
      <table>
        <thead>
          {hasGroups && (
            <tr class="groups">
              {showRank && <th />}
              {groups.map((g) => (
                <th colspan={g.span} class:list={[{ grp: g.label }, `role-${g.key}`]}>{g.label}</th>
              ))}
            </tr>
          )}
          <tr>
            {showRank && <th class="rank num">#</th>}
            {columns.map((c, i) => (
              <th
                class:list={[{ num: c.numeric, ph: c.phone === false, sorted: i === table.sortColumn }]}
                title={c.tip}
                data-col={table.sortable === false ? undefined : i}
                data-numeric={c.numeric ? '1' : undefined}
                aria-sort={i === table.sortColumn ? (table.desc ? 'descending' : 'ascending') : undefined}
              >{table.sortable === false ? c.label : <button type="button">{c.label}</button>}</th>
            ))}
          </tr>
        </thead>
        {order.map((r, pos) => (
          <tbody class:list={{ extra: collapsed !== undefined && pos >= collapsed }}>
            <tr class:list={['row', { tappable: hasHidden }]}>
              {showRank && <td class:list={['rank num', pos < 3 && `r${pos + 1}`]} data-rank>{pos + 1}</td>}
              {table.rows[r].map((cell, i) => (
                <td
                  class:list={[toneClass(cell), { num: columns[i].numeric, ph: columns[i].phone === false, sorted: i === table.sortColumn }]}
                  data-s={cell.s}
                  data-alt={cell.link && profileFor(cell.link)?.nick ? cell.t : undefined}
                >
                  {cell.tone === 'wr' && cell.s !== undefined && <span class="bar" style={`--w:${Math.round(cell.s * 100)}%`} />}
                  {cell.link ? <PlayerName slug={cell.link} name={cell.t} /> : cell.t}
                </td>
              ))}
            </tr>
            {hasHidden && (
              <tr class="detail"><td colspan={colCount}>
                <dl>
                  {columns.map((c, i) => c.phone === false && (
                    <div><dt>{c.group ? `${c.group} ${c.label}` : c.label}</dt><dd class={toneClass(table.rows[r][i])}>{table.rows[r][i].t}</dd></div>
                  ))}
                </dl>
              </td></tr>
            )}
          </tbody>
        ))}
      </table>
    </div>
    {collapsed !== undefined && <button type="button" class="more" data-more>Показати всі ({table.rows.length})</button>}
  </div>
)}

<script>
  import { enhanceTables } from './table';
  enhanceTables();
</script>

<style>
  .empty { color: var(--muted); margin: 8px 0; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { padding: 0 10px; height: 44px; white-space: nowrap; text-align: left; border-bottom: 1px solid var(--line); }
  .compact th, .compact td { height: 32px; padding: 0 8px; }
  th { position: sticky; top: 0; background: var(--panel-2); font-weight: 700; color: var(--muted); font-size: 11px;
    text-transform: uppercase; letter-spacing: .04em; height: 38px; border-bottom-color: var(--border); }
  .compact th { height: 30px; }
  th button { all: unset; cursor: pointer; }
  th button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  th.sorted { color: var(--text); }
  th[aria-sort='descending'] button::after { content: ' ↓'; }
  th[aria-sort='ascending'] button::after { content: ' ↑'; }
  tr.groups th { height: 28px; border-bottom: 0; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; background: var(--panel); }
  tr.groups th.grp { text-align: center; color: #fff; }
  tr.groups th.role-civilian { background: var(--role-civilian-bg); }
  tr.groups th.role-sheriff { background: var(--role-sheriff-bg); }
  tr.groups th.role-mafia { background: var(--role-mafia-bg); }
  tr.groups th.role-don { background: var(--role-don-bg); }
  .num { text-align: center; }
  td.sorted { background: var(--panel-2); font-weight: 700; }
  tbody:hover td { background-color: var(--panel-2); }
  td:first-child, th:first-child { position: sticky; left: 0; background: var(--panel); z-index: 1; }
  thead tr:not(.groups) th:first-child { background: var(--panel-2); }
  .rank + td { position: sticky; left: 48px; background: var(--panel); z-index: 1; box-shadow: inset -1px 0 var(--border); }
  thead .rank + th { left: 48px; background: var(--panel-2); box-shadow: inset -1px 0 var(--border); }
  .rank { width: 48px; min-width: 48px; color: var(--muted); font-family: var(--font-display); font-weight: 700; font-size: 15px; }
  /* Gold / silver / bronze squares behind the top three (renumber() moves r1–r3 after a sort). */
  .rank.r1, .rank.r2, .rank.r3 { color: #111318; background-repeat: no-repeat; background-position: center; background-size: 28px 28px; }
  .rank.r1 { background-image: linear-gradient(var(--gold), var(--gold)); }
  .rank.r2 { background-image: linear-gradient(var(--silver), var(--silver)); }
  .rank.r3 { background-image: linear-gradient(var(--bronze), var(--bronze)); color: #fff; }
  .compact .rank.r1, .compact .rank.r2, .compact .rank.r3 { background-size: 22px 22px; }
  .compact .rank { width: 36px; min-width: 36px; font-size: 13px; }
  .compact .rank + td { left: 36px; }
  td a { font-weight: 600; }
  td { position: relative; }
  .bar { position: absolute; left: 10px; right: 10px; bottom: 6px; height: 3px; background: var(--line); }
  .bar::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w); background: currentColor; opacity: .7; }
  tbody.extra, tbody[hidden] { display: none; }
  .dt.open tbody[hidden] { display: none; }
  .dt.open tbody.extra { display: table-row-group; }
  .more { margin-top: 10px; background: none; border: 1px solid var(--border);
    color: var(--text); padding: 7px 14px; font: inherit; font-weight: 600; cursor: pointer; }
  .more:hover { border-color: var(--text); }
  .dt.open .more { display: none; }
  tr.detail { display: none; }
  dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 6px 16px; margin: 8px 0; }
  dl div { display: flex; justify-content: space-between; gap: 8px; }
  dt { color: var(--muted); } dd { margin: 0; }
  /* «Коротко»: the same columns a phone shows. */
  .dt.short .ph, .dt.short tr.groups { display: none; }
  @media (max-width: 899px) {
    th, td { height: 44px; }
    .ph, tr.groups { display: none; }
    tr.tappable { cursor: pointer; }
    tbody.expanded tr.detail { display: table-row; }
    tr.detail td { white-space: normal; height: auto; }
  }
</style>
