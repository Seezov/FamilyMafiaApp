---
interface Props { title?: string; note?: string; class?: string }
const { title, note, class: cls } = Astro.props;
---
<section class:list={['panel', cls]}>
  {(title || Astro.slots.has('actions')) && (
    <header>
      {title && <h2>{title}</h2>}
      {note && <span class="note">{note}</span>}
      <div class="actions"><slot name="actions" /></div>
    </header>
  )}
  <div class="body"><slot /></div>
</section>

<style>
  .panel { background: var(--panel); min-width: 0; }
  header { display: flex; align-items: baseline; gap: 6px 14px; padding: 14px 20px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
  h2 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 22px; line-height: 1.2;
    text-transform: uppercase; letter-spacing: .01em; color: var(--text); }
  .note { color: var(--muted); font-size: 13px; }
  .actions { margin-left: auto; }
  .body { padding: 16px 20px; }
</style>
