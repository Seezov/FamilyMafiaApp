---
// A player link showing the profile nick and avatar.
import { nameFor, profileFor } from '../lib/profiles/site';
import { href, playerHref } from '../lib/url';

/** `avatar={false}`: next to a large avatar already shown. */
interface Props { slug: string; name: string; avatar?: boolean }
const { slug, name, avatar = true } = Astro.props;
const prof = profileFor(slug);
---
<a class="pn" href={playerHref(slug)} title={prof?.nick ? name : undefined}>{avatar && prof?.avatar && <img src={href(prof.avatar)} alt="" width="28" height="28" loading="lazy" decoding="async" />}{nameFor(slug, name)}</a>

<style>
  /* Inline (not flex) so the line keeps the name's text baseline: a row aligned by baseline stays level.
     Negative margins keep the 28px avatar from making the line taller. */
  .pn { white-space: nowrap; }
  .pn img { display: inline-block; width: 28px; height: 28px; margin: -8px 8px -6px 0; vertical-align: middle;
    border-radius: 50%; object-fit: cover; object-position: center; }
</style>
