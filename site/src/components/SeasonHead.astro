---
import { loadGames, loadIndex, loadSeason } from '../lib/data';
import { attendanceHref, gamesHref, seasonHref } from '../lib/url';

interface Props { id: number; tab: 'main' | 'small' | 'games' | 'attendance' }
const { id, tab } = Astro.props;
const season = loadSeason(id);
const seasons = [...loadIndex().seasons].reverse();
const link = (sid: number) =>
  tab === 'games' ? gamesHref(sid) : tab === 'attendance' ? attendanceHref(sid) : seasonHref(sid, tab === 'small');
// The newest few seasons as quick buttons, the rest in «Усі ▾» (the current one is always a button).
const pos = seasons.findIndex((x) => x.id === id);
const quick = seasons.slice(0, 5).some((x) => x.id === id) ? seasons.slice(0, 5) : [...seasons.slice(0, 4), seasons[pos]];
const quickIds = new Set(quick.map((x) => x.id));
const short = (x: { id: number; title: string }) => (/^\D*\d+$/.test(x.title) ? `S${x.id}` : x.title);
// Month span from the dated games, e.g. «вересень — листопад 2026».
const MONTHS = ['січень', 'лютий', 'березень', 'квітень', 'травень', 'червень', 'липень', 'серпень', 'вересень', 'жовтень', 'листопад', 'грудень'];
let span = '';
try {
  const dates = loadGames(id).days.map((d) => d.date).filter((d): d is string => !!d).sort();
  if (dates.length) {
    const [y1, m1] = dates[0].split('-').map(Number);
    const [y2, m2] = dates.at(-1)!.split('-').map(Number);
    span = y1 === y2 && m1 === m2 ? `${MONTHS[m1 - 1]} ${y1}`
      : y1 === y2 ? `${MONTHS[m1 - 1]} — ${MONTHS[m2 - 1]} ${y2}` : `${MONTHS[m1 - 1]} ${y1} — ${MONTHS[m2 - 1]} ${y2}`;
  }
} catch { /* a season without a games file */ }
const tabs = [
  { key: 'main', label: 'Вища ліга', url: seasonHref(id) },
  { key: 'small', label: 'Мала ліга', url: seasonHref(id, true) },
  { key: 'games', label: 'Ігри', url: gamesHref(id), count: season.summary?.games },
  { key: 'attendance', label: 'Відвідуваність', url: attendanceHref(id) },
];
---
<div class="band">
  <div class="wrap">
    <div class="top">
      <div>
        <div class="eyebrow">Клубний сезон{span && ` · ${span}`}</div>
        <h1 class="display">{season.title}</h1>
      </div>
      <nav class="seasons" aria-label="Сезон">
        {quick.map((x) => <a href={link(x.id)} aria-current={x.id === id ? 'page' : undefined}>{short(x)}</a>)}
        <details class="picker">
          <summary>Усі <span aria-hidden="true">▾</span></summary>
          <ul>
            {seasons.map((x) => <li><a href={link(x.id)} aria-current={x.id === id ? 'page' : undefined} class:list={{ dup: quickIds.has(x.id) }}>{x.title}</a></li>)}
          </ul>
        </details>
      </nav>
    </div>
    <nav class="tabs" aria-label="Розділ">
      {tabs.map((t) => (
        <a href={t.url} aria-current={tab === t.key ? 'page' : undefined}>{t.label}{t.count !== undefined && <span class="count">{t.count}</span>}</a>
      ))}
    </nav>
    {Astro.slots.has('default') && <div class="extra"><slot /></div>}
  </div>
</div>

<style>
  .band { background: var(--panel); border-bottom: 1px solid var(--border);
    margin: -24px calc(50% - 50vw) 24px; }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; padding-top: 26px; }
  .eyebrow { font-size: 12px; font-weight: 700; color: var(--city); text-transform: uppercase; letter-spacing: .08em; }
  h1 { margin-top: 2px; }
  .seasons { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: var(--bg); }
  .seasons > a, .picker summary { padding: 7px 13px; font-weight: 600; color: var(--muted); cursor: pointer; }
  .seasons > a:hover, .picker summary:hover { color: var(--text); }
  .seasons > a[aria-current='page'] { background: var(--text); color: var(--panel); }
  .picker { position: relative; }
  .picker summary { list-style: none; }
  .picker summary::-webkit-details-marker { display: none; }
  .picker ul { position: absolute; right: 0; z-index: 20; margin: 6px 0 0; padding: 6px; list-style: none;
    background: var(--panel); border: 1px solid var(--border); box-shadow: 0 8px 24px var(--shadow);
    max-height: 60vh; overflow-y: auto; min-width: 180px; }
  .picker li a { display: block; padding: 6px 10px; }
  .picker li a:hover { background: var(--panel-2); }
  .picker li a[aria-current='page'] { color: var(--city); font-weight: 700; }
  .tabs { display: flex; gap: 4px; margin-top: 20px; overflow-x: auto; scrollbar-width: none; }
  .tabs a { padding: 12px 16px; font-weight: 600; color: var(--muted); white-space: nowrap; }
  .tabs a:hover { color: var(--text); }
  .tabs a[aria-current='page'] { color: var(--text); font-weight: 700; box-shadow: inset 0 -3px var(--city); }
  .count { margin-left: 6px; font-size: 12px; padding: 1px 6px; background: var(--bg); color: var(--muted); }
  .extra { padding-bottom: 14px; }
</style>
