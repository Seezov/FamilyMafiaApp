---
import '../styles/global.css';
import logoSvg from '../../public/logo.svg?raw';
import { absolute, href } from '../lib/url';
import { loadIndex } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  active?: 'season' | 'players' | 'overview' | 'records' | 'tournaments' | 'allstars' | 'annual' | 'debug' | 'host';
}
const { title, description = 'Статистика Family Mafia Club: сезони, гравці, рекорди, турніри.', active } = Astro.props;
const { latestSeasonId } = loadIndex();
// Overview, Records, Tournaments and All Stars are hidden from the menu for now (pages still build); Debug shows for admins only.
const nav = [
  { key: 'season', label: 'Сезон', url: href(`season/${latestSeasonId}/`) },
  { key: 'players', label: 'Гравці', url: href('players/') },
  { key: 'annual', label: 'Річний рейтинг', url: href('annual/') },
];
const site = 'Family Mafia Club';
// Inline so the monogram follows the theme (--logo-* in global.css).
const [, , logoW, logoH] = logoSvg.match(/viewBox="([^"]+)"/)![1].split(' ').map(Number);
const logo = logoSvg
  .replace('<svg ', `<svg width="${Math.round(32 * logoW / logoH)}" height="32" aria-hidden="true" `)
  .replaceAll('#fff', 'var(--logo-ink)').replaceAll('#000', 'var(--logo-cut)');
const fullTitle = title === site ? title : `${title} · ${site}`;
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absolute('og.png')} />
    <meta property="og:url" content={new URL(Astro.url.pathname, 'https://seezov.github.io').toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#111318" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@500;600;700&display=swap&subset=cyrillic"
    />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="logo display" href={href(`season/${latestSeasonId}/`)} aria-label="Family Mafia Club — на головну"><span class="mark" set:html={logo} /><span>Family Mafia Club</span></a>
        <nav class="tabs" aria-label="Розділи">
          {nav.map((n) => (
            <a href={n.url} aria-current={n.key === active ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href={href('debug/')} class="admin-only" hidden aria-current={active === 'debug' ? 'page' : undefined}>Debug</a>
        </nav>
        <a class="host-btn" href={href('host/')} aria-current={active === 'host' ? 'page' : undefined}>Провести гру</a>
        <a class="account" href={href('account/')} aria-label="Мій профіль" title="Мій профіль"><span>Увійти</span></a>
        <button class="theme" type="button" aria-label="Світла / темна тема" title="Світла / темна тема">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 0 0 18z" /></svg>
        </button>
        <form class="search" action={href('players/')} method="get" role="search">
          <input name="q" type="search" placeholder="Знайти гравця…" aria-label="Знайти гравця" />
        </form>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="foot"><div class="wrap">Family Mafia Club · статистика клубу · оновлюється щоночі</div></footer>
    <script is:inline>
      document.querySelector('.theme').addEventListener('click', () => {
        const root = document.documentElement;
        const light = root.dataset.theme
          ? root.dataset.theme === 'light'
          : matchMedia('(prefers-color-scheme: light)').matches;
        root.dataset.theme = light ? 'dark' : 'light';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
      // Admin-only links: the flag is set by pages that check the signed-in user (lib/admin-flag.ts).
      try { if (localStorage.getItem('fm-admin') === '1') document.querySelectorAll('.admin-only').forEach((a) => { a.hidden = false; }); } catch {}
      try {
        const acc = JSON.parse(localStorage.getItem('fm-account') || 'null');
        const a = document.querySelector('.account');
        if (acc && a) {
          a.textContent = '';
          if (acc.avatar) {
            const img = document.createElement('img');
            img.src = acc.avatar; img.alt = ''; img.width = 40; img.height = 40;
            a.append(img);
          } else {
            const s = document.createElement('span');
            s.className = 'initial';
            s.textContent = (acc.label || '?').slice(0, 1).toUpperCase();
            a.append(s);
          }
          a.title = acc.label || 'Мій профіль';
        }
      } catch {}
    </script>
  </body>
</html>

<style>
  .top { position: sticky; top: 0; z-index: 10; background: var(--header-bg); color: var(--header-text); }
  .bar { display: flex; align-items: center; gap: 24px; height: 64px; }
  .logo { display: flex; align-items: center; gap: 12px; font-size: 20px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .05em; white-space: nowrap; color: var(--header-text); }
  .logo:hover { color: var(--header-text); }
  .mark { display: grid; place-items: center; flex: none; }
  .mark :global(svg) { display: block; }
  .tabs { display: flex; height: 100%; }
  .tabs a { display: flex; align-items: center; padding: 0 16px; color: var(--header-muted);
    font-weight: 600; white-space: nowrap; }
  .tabs a:hover { color: var(--header-text); }
  .tabs a[hidden] { display: none; }
  .tabs a[aria-current='page'] { color: var(--header-text); box-shadow: inset 0 -3px var(--city); }
  .host-btn { margin-left: auto; padding: 8px 14px; border: 1.5px solid var(--header-text); color: var(--header-text);
    font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; }
  .host-btn:hover, .host-btn[aria-current='page'] { background: var(--header-text); color: var(--header-bg); }
  .theme { display: grid; place-items: center; width: 34px; height: 34px; padding: 0;
    background: none; border: 1px solid var(--header-line); color: var(--header-muted); cursor: pointer; }
  .theme:hover { color: var(--header-text); }
  .account { display: grid; place-items: center; min-width: 34px; height: 34px; padding: 0 10px;
    border: 1px solid var(--header-line); color: var(--header-muted); font-size: 13px; font-weight: 600; white-space: nowrap; }
  .account:hover { color: var(--header-text); }
  .account:has(img), .account:has(.initial) { padding: 0; width: 40px; height: 40px; border-radius: 50%; overflow: hidden; }
  .account img { width: 100%; height: 100%; object-fit: cover; }
  .account .initial { font-weight: 700; color: var(--header-text); }
  .theme svg { width: 16px; height: 16px; fill: currentColor; stroke: currentColor; stroke-width: 2; }
  .theme svg circle { fill: none; }
  .search input { width: 200px; background: rgba(255, 255, 255, .08); border: 1px solid var(--header-line);
    color: var(--header-text); padding: 7px 10px; font: inherit; }
  .search input::placeholder { color: var(--header-muted); }
  .foot { background: var(--header-bg); color: var(--header-muted); font-size: 13px; }
  .foot .wrap { padding-top: 22px; padding-bottom: 22px; }
  @media (max-width: 1099px) { .search input { width: 140px; } }
  @media (max-width: 899px) {
    .bar { flex-wrap: wrap; height: auto; gap: 0 10px; padding-top: 10px; }
    .logo { font-size: 16px; }
    .tabs { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; height: 46px; }
    .tabs a { padding: 0 12px; }
  }
  @media (max-width: 560px) { .logo span:last-child { display: none; } .search { display: none; } }
</style>
