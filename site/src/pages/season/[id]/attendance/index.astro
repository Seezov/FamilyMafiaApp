---
import Base from '../../../../layouts/Base.astro';
import PlayerName from '../../../../components/PlayerName.astro';
import SeasonHead from '../../../../components/SeasonHead.astro';
import { attendance, attendanceText } from '../../../../lib/attendance';
import { loadGames, loadIndex, loadSeason } from '../../../../lib/data';
import { dayLabel } from '../../../../lib/games';
import { gamesHref } from '../../../../lib/url';

export function getStaticPaths() {
  return loadIndex().seasons.map((s) => ({ params: { id: String(s.id) } }));
}
const id = Number(Astro.params.id);
const season = loadSeason(id);
const { days, totals } = attendance(loadGames(id));
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---
<Base title={`${season.title} · Attendance`} description={`${season.title}: who played on each game day`} active="season">
  <SeasonHead id={id} tab="attendance" />
  <p class="intro">Who played on each game day and how many games, newest first — every game counts, rated or not.
    “Copy” puts the day's list on the clipboard for the chat.</p>
  <div class="days">
    {days.map((d) => (
      <section class="day">
        <header>
          <h2 class="label">{dayLabel(d.date)}</h2>
          <button type="button" class="copy" data-text={attendanceText(`${dayLabel(d.date)} · ${plural(d.games, 'game', 'games')}`, d.players)}>Copy</button>
        </header>
        <p class="meta">
          <a href={gamesHref(id)}>{plural(d.games, 'game', 'games')}</a> · {plural(d.players.length, 'player', 'players')}
          {d.hosts.length > 0 && <> · host {d.hosts.join(', ')}</>}
          {d.labels.map((l) => <span class="tag">{l}</span>)}
        </p>
        <ol>
          {d.players.map((p) => (
            <li><span>{p.slug ? <PlayerName slug={p.slug} name={p.name} /> : p.name}</span><span class="num">{p.games}</span></li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <section class="totals">
    <h2 class="label">Season totals</h2>
    <table>
      <thead><tr><th>Player</th><th class="num">Days</th><th class="num">Games</th></tr></thead>
      <tbody>
        {totals.map((t) => (
          <tr><td>{t.slug ? <PlayerName slug={t.slug} name={t.name} /> : t.name}</td><td class="num">{t.days}</td><td class="num">{t.games}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>

<script>
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button.copy');
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.text!); b.textContent = 'Copied'; } catch { b.textContent = 'Failed'; }
    setTimeout(() => (b.textContent = 'Copy'), 1500);
  });
</script>

<style>
  .intro { color: var(--muted); margin: 0 0 16px; max-width: 70ch; }
  .days { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .day, .totals { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; min-width: 0; }
  .day header { display: flex; align-items: baseline; gap: 8px; }
  .day h2 { margin: 0; color: var(--text); font-weight: 600; }
  .copy { margin-left: auto; background: none; border: 1px solid var(--border); border-radius: 999px;
    color: var(--muted); font: inherit; font-size: 12px; padding: 2px 10px; cursor: pointer; }
  .copy:hover { color: var(--accent); border-color: var(--accent); }
  .meta { color: var(--muted); font-size: 12px; margin: 4px 0 10px; }
  .meta a { text-decoration: underline; text-decoration-color: var(--border); }
  .tag { display: inline-block; margin-left: 6px; padding: 0 8px; border: 1px solid var(--border); border-radius: 999px; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: flex; justify-content: space-between; gap: 8px; padding: 3px 0; border-top: 1px solid var(--border); }
  li:first-child { border-top: 0; }
  .totals { margin-top: 24px; max-width: 480px; }
  .totals h2 { margin: 0 0 8px; color: var(--text); font-weight: 600; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-weight: 500; color: var(--muted); font-size: 12px; padding: 4px 0; }
  td { padding: 4px 0; border-top: 1px solid var(--border); }
  .num { text-align: right; }
</style>
