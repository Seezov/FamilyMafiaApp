---
interface Props { label: string; value: string; tone?: 'city' | 'mafia'; note?: string }
const { label, value, tone, note } = Astro.props;
---
<div class:list={['kpi', tone && `t-${tone}`]}>
  <div class="label">{label}</div>
  <div class="display value">{value}</div>
  {note && <div class="note">{note}</div>}
</div>

<style>
  .kpi { background: var(--panel); border-top: 4px solid var(--text); padding: 14px 18px; min-width: 0; }
  .kpi.t-city { border-top-color: var(--city); }
  .label { font-weight: 600; font-size: 12px; letter-spacing: .02em; }
  .value { font-size: 40px; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .t-city .value { color: var(--city); }
  .note { font-size: 12px; color: var(--muted); }
</style>
