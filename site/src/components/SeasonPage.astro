---
import Base from '../layouts/Base.astro';
import DataTable from './DataTable.astro';
import Kpi from './Kpi.astro';
import Panel from './Panel.astro';
import PlayerName from './PlayerName.astro';
import SeasonAwards from './SeasonAwards.astro';
import SeasonHead from './SeasonHead.astro';
import { loadGames, loadSeason } from '../lib/data';
import { GAMES, PLAYERS, pct, ukCount } from '../lib/format';
import { fmtPts } from '../lib/games';
import { gamesHref } from '../lib/url';
import type { GameEntry } from '../lib/types';

interface Props { id: number; small: boolean }
const { id, small } = Astro.props;
const season = loadSeason(id);
const league = small ? season.leagues.small : season.leagues.main;
const s = season.summary;
const dash = '—';
const description = s
  ? `${season.title}: ${ukCount(s.games, GAMES)}, ${ukCount(s.players, PLAYERS)}, місто виграло ${pct(s.cityWR)}.`
  : season.title;
const cityWins = s ? Math.round(s.games * s.cityWR) : 0;
const mafiaWins = s ? Math.round(s.games * s.mafiaWR) : 0;
const mainNote = season.thresholdLive && season.thresholdFormula !== null
  ? `від ${season.gameLimit} ігор · формула ${season.thresholdFormula.toFixed(1)}`
  : `від ${season.gameLimit} ігор`;
const smallNote = `${season.smallLeagueMinGames}–${season.gameLimit - 1} ігор`;
const hasShort = league.ratings.columns.some((c) => c.phone === false);

// The last dated game evening (main tab only).
type Day = { date: string; games: GameEntry[] };
let lastDay: Day | undefined;
if (!small) {
  try {
    const days = loadGames(id).days.filter((d): d is Day => !!d.date);
    lastDay = days.sort((a, b) => b.date.localeCompare(a.date))[0];
  } catch { /* no games file */ }
}
const MONTHS_GEN = ['січня', 'лютого', 'березня', 'квітня', 'травня', 'червня', 'липня', 'серпня', 'вересня', 'жовтня', 'листопада', 'грудня'];
const dayTitle = (d: string) => { const [, m, dd] = d.split('-').map(Number); return `${dd} ${MONTHS_GEN[m - 1]}`; };
const best = (g: GameEntry) => g.seats.filter((x) => x.player && x.total !== undefined)
  .sort((a, b) => (b.total ?? 0) - (a.total ?? 0))[0];
const resultLabel = { city: 'Місто', mafia: 'Мафія', unrated: 'Не рейтинг' } as const;
const statParts = (w: string) => { const i = w.indexOf(' · '); return i < 0 ? [w, ''] : [w.slice(0, i), w.slice(i + 3)]; };
---
<Base title={`${season.title}${small ? ' · Мала ліга' : ''}`} description={description} active="season">
  <SeasonHead id={id} tab={small ? 'small' : 'main'}>
    {season.tournamentCounts.length > 0 && (
      <div class="pills">
        {season.tournamentCounts.map((t) => <span class="pill">{t.label}: {t.count}</span>)}
      </div>
    )}
  </SeasonHead>

  <div class="stack">
    <section class="kpis">
      <Kpi label="Ігор" value={s ? String(s.games) : dash} />
      <Kpi label="Гравців" value={s ? String(s.players) : dash} />
      <div class="vs">
        <div class="label">Місто проти мафії</div>
        {s ? (
          <>
            <div class="vs-nums display"><span class="c">{cityWins} · {pct(s.cityWR)}</span><span>{pct(s.mafiaWR)} · {mafiaWins}</span></div>
            <div class="vs-bar"><span class="c" style={`width:${(s.cityWR * 100).toFixed(1)}%`} /><span class="m" style={`width:${(s.mafiaWR * 100).toFixed(1)}%`} /></div>
          </>
        ) : <div class="vs-nums display">{dash}</div>}
      </div>
      <Kpi label="Вища ліга" value={season.leagueCounts ? String(season.leagueCounts.main) : dash} note={mainNote} />
      <Kpi label="Мала ліга" value={season.leagueCounts ? String(season.leagueCounts.small) : dash} note={smallNote} />
    </section>

    {league.awards && league.awards.length > 0 && (
      <section>
        <h2 class="h-section sec-gap">Номінації</h2>
        <SeasonAwards awards={league.awards} />
      </section>
    )}

    <Panel title="Рейтинг гравців" note={`${small ? smallNote : mainNote} · натисніть заголовок, щоб сортувати`}>
      {hasShort && (
        <div slot="actions" class="seg" role="group" aria-label="Колонки">
          <button type="button" data-cols="short" aria-pressed="false">Коротко</button>
          <button type="button" data-cols="all" aria-pressed="true">Усі колонки</button>
        </div>
      )}
      <div class="ratings"><DataTable table={league.ratings} /></div>
    </Panel>

    {league.stats.length > 0 && (
      <section>
        <h2 class="h-section sec-gap">Статистика сезону</h2>
        <div class="stats">
          {league.stats.map((st) => {
            const [name, value] = statParts(st.winner);
            const rows = st.table?.rows ?? [];
            const winnerLink = rows[0]?.[0]?.link;
            return (
              <article class="stat">
                <div class="label">{st.label}</div>
                <div class="stat-top">
                  <span class="stat-name">{winnerLink ? <PlayerName slug={winnerLink} name={name} /> : name}</span>
                  {value && <span class="display stat-val">{value}</span>}
                </div>
                {rows.length > 1 && (
                  <ol>
                    {rows.slice(1, 4).map((r) => (
                      <li><span class="n">{r[0].link ? <PlayerName slug={r[0].link} name={r[0].t} /> : r[0].t}</span><span class="d">{r[1]?.t}</span><span class="v">{r[2]?.t}</span></li>
                    ))}
                  </ol>
                )}
              </article>
            );
          })}
        </div>
      </section>
    )}

    {lastDay && (
      <Panel title={`Останній ігровий вечір · ${dayTitle(lastDay.date)}`}>
        <a slot="actions" class="all-link" href={gamesHref(id)}>Усі {s ? ukCount(s.games, GAMES) : 'ігри'} →</a>
        <ul class="games">
          {lastDay.games.map((g) => {
            const b = best(g);
            return (
              <li>
                <a href={`${gamesHref(id)}#${g.id}`}>
                  <span class="g-n display">#{g.n}</span>
                  <span class={`g-res r-${g.result}`}>{resultLabel[g.result]}</span>
                  <span class="g-col g-host"><span class="muted small">Ведучий</span><span class="strong">{g.host ?? '—'}</span></span>
                  {b && <span class="g-col g-best"><span class="muted small">Кращий гравець</span><span><span class="strong">{b.player}</span> <span class="tone-pos strong">{fmtPts(b.total)}</span></span></span>}
                </a>
              </li>
            );
          })}
        </ul>
      </Panel>
    )}
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.seg').forEach((seg) => {
    const dt = seg.closest('.panel')?.querySelector<HTMLElement>('.ratings .dt');
    if (!dt) return;
    const set = (mode: string) => {
      dt.classList.toggle('short', mode === 'short');
      seg.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cols === mode)));
    };
    seg.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      set(b.dataset.cols!);
      try { localStorage.setItem('fm-cols', b.dataset.cols!); } catch { /* private mode */ }
    }));
    try { const m = localStorage.getItem('fm-cols'); if (m) set(m); } catch { /* private mode */ }
  });
</script>

<style>
  .stack { display: flex; flex-direction: column; gap: 32px; }
  .kpis { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .vs { grid-column: span 2; background: var(--panel); border-top: 4px solid var(--city); padding: 14px 18px; min-width: 0; }
  .vs .label { font-weight: 600; font-size: 12px; letter-spacing: .02em; }
  .vs-nums { display: flex; justify-content: space-between; gap: 8px; font-size: 30px; line-height: 1.3; }
  .vs-nums .c { color: var(--city); }
  .vs-bar { display: flex; height: 8px; margin-top: 4px; }
  .vs-bar .c { background: var(--city); } .vs-bar .m { background: var(--mafia); }
  @media (max-width: 899px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .vs-nums { font-size: 22px; } }
  .sec-gap { margin-bottom: 14px; }
  .muted { color: var(--muted); }
  .small { font-size: 12px; }
  .strong { font-weight: 700; }
  .ratings { margin: -16px -20px; }
  .seg { display: flex; gap: 4px; }
  .seg button { font: inherit; font-size: 13px; font-weight: 600; padding: 6px 12px; cursor: pointer;
    background: none; color: var(--muted); border: 1px solid var(--border); }
  .seg button[aria-pressed='true'] { background: var(--text); color: var(--panel); border-color: var(--text); }
  @media (max-width: 899px) { .seg { display: none; } }
  .stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr)); gap: 16px; }
  .stat { background: var(--panel); padding: 16px 18px; border-top: 4px solid var(--text); min-width: 0; }
  .stat .label { font-weight: 700; font-size: 12px; }
  .stat-top { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: 6px; }
  .stat-name { font-size: 19px; font-weight: 800; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stat-val { font-size: 30px; white-space: nowrap; }
  .stat ol { list-style: none; margin: 10px 0 0; padding: 6px 0 0; border-top: 1px solid var(--line); }
  .stat li { display: flex; gap: 10px; padding: 4px 0; font-size: 13px; }
  .stat .n { flex: 1; min-width: 0; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stat .d { color: var(--muted); }
  .stat .v { min-width: 40px; text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .all-link { font-weight: 700; font-size: 13px; color: var(--city); white-space: nowrap; }
  .games { list-style: none; margin: -16px -20px; padding: 0; }
  .games li + li { border-top: 1px solid var(--line); }
  .games a { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; padding: 12px 20px; }
  .games a:hover { background: var(--panel-2); color: inherit; }
  .g-n { width: 40px; font-size: 22px; color: var(--muted); }
  .g-res { width: 96px; padding: 5px 0; text-align: center; font-weight: 700; font-size: 12px; text-transform: uppercase; color: #fff; }
  .r-city { background: var(--role-civilian-bg); } .r-mafia { background: var(--role-mafia-bg); } .r-unrated { background: var(--muted); }
  .g-col { display: flex; flex-direction: column; line-height: 1.35; }
  .g-host { flex: 1; }
  .g-best { text-align: right; }
</style>
