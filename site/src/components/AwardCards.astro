---
import type { AwardCard } from '../lib/types';

interface Props { groups: { title: string; cards: AwardCard[] }[] }
const { groups } = Astro.props;

// 24×24 stroke icons, one per award kind.
const icons: Record<AwardCard['icon'], string> = {
  trophy: '<path d="M7 4h10v4a5 5 0 0 1-10 0z"/><path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3M12 13v4M8 21h8M9.5 17h5"/>',
  medal: '<path d="M8 3l4 7 4-7"/><circle cx="12" cy="15" r="5"/><path d="M12 13v4"/>',
  star: '<path d="M12 3l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/>',
  sheriff: '<path d="M12 3l7 3v5c0 4.6-3 7.8-7 10-4-2.2-7-5.4-7-10V6z"/><path d="M12 9l1 2 2 .3-1.5 1.4.4 2.1L12 13.8l-1.9 1 .4-2.1L9 11.3l2-.3z"/>',
  civilian: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>',
  mafia: '<path d="M3 17c4 2 14 2 18 0"/><path d="M6 16l1.6-7.5C8.2 5.5 15.8 5.5 16.4 8.5L18 16"/><path d="M7 12.5h10"/>',
  don: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
};
---
<div class="groups">
  {groups.map((g) => (
    <section>
      <h3 class="label">{g.title}</h3>
      <div class="cards">
        {g.cards.map((c) => (
          <article class={`card tone-${c.tone}`}>
            <div class="head">
              <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[c.icon]} /></span>
              <span class="count display">×{c.count}</span>
            </div>
            <div class="title">
              {c.kind && <span class={`kind k-${c.kindType}`}>{c.kind}</span>}
              <span>{c.label}</span>
            </div>
            <ul class="where">
              {c.where.map((w) => <li title={w}>{w}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .groups { display: grid; gap: 18px; }
  h3 { margin: 0 0 8px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }

  .tone-gold { --c: var(--gold); } .tone-silver { --c: var(--silver); } .tone-bronze { --c: #D08A57; }
  .tone-mvp { --c: #F87171; } .tone-sheriff { --c: var(--sheriff); } .tone-civilian { --c: #FB923C; }
  .tone-mafia { --c: var(--mafia); } .tone-don { --c: var(--don); }
  .k-minicap { --k: #5CC7B6; } .k-maxicap { --k: #E9A948; } .k-bigcap { --k: #E08795; }
  .k-marathon { --k: #9AA2EC; } .k-tournament { --k: #B3ADB2; }

  .card { border: 1px solid color-mix(in srgb, var(--c) 35%, var(--border)); border-radius: 10px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--c) 13%, var(--panel)) 0%, var(--panel) 70%);
    padding: 12px 14px; display: grid; gap: 6px; align-content: start; min-width: 0; }
  .head { display: flex; align-items: center; justify-content: space-between; }
  .icon { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
    background: color-mix(in srgb, var(--c) 20%, transparent); color: var(--c); }
  .icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round; }
  .count { font-size: 24px; line-height: 1; color: var(--c); }
  .title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; font-weight: 600; }
  .kind { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--k); }
  .where { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px;
    font-size: 12px; color: var(--muted); }
  .where li { padding: 1px 7px; border-radius: 999px; background: rgba(255, 255, 255, .05);
    max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
